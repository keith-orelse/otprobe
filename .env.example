# Copy to .env.

# ---- Live network safety (docs/SAFETY_AND_SCOPE.md) ---------------------------------------------------------------
# Safe mode applies the OT-sensitive limits (10 pkt/s per range, 1 op/s per host) to every range. An admin can turn
# it off in Settings -> Safety, with a reason that is audited.
SAFE_MODE=true
# Global ceiling for active discovery, packets per second.
SCAN_MAX_PPS=50

# ---- Secrets ----------------------------------------------------------------------------------------------------
# First-start passwords (min 12 characters). If empty, random passwords are generated and printed ONCE in the API
# log ("created account ... with generated password ...").
OTPROBE_ADMIN_PASSWORD=
OTPROBE_OPERATOR_PASSWORD=
OTPROBE_APPROVER_PASSWORD=
# Credential vault key (Fernet). Leave empty to generate one into the keys volume on first start. Back it up:
# stored credentials cannot be decrypted without it.
VAULT_KEY=
# Leave as the demo value: live mode replaces it with a generated key file. Set your own to pin it.
JWT_SECRET=change-me-demo-jwt-secret-at-least-32-bytes

# ---- Agents and assessments -------------------------------------------------------------------------------------
HEARTBEAT_INTERVAL_SEC=10
ASSESSMENT_INTERVAL_SEC=300
ASSESSMENT_TIMEOUT_SEC=120
ENROLLMENT_TIMEOUT_SEC=120

# ---- Bundled MQTT broker, Mode A (docs/MQTT_BROKER.md) ----------------------------------------------------------
# "bundled" runs Mosquitto next to OTProbe (needs the mosquitto program: included in the Docker image; on a Mac
# `brew install mosquitto`). "off" = no MQTT telemetry.
MQTT_BROKER=bundled
# Devices connect here with TLS, using the server certificate next to OTPROBE_TLS_CA_FILE.
MQTT_PORT=8883
# Plain MQTT for devices that cannot do TLS. 0 = off (recommended); while on, check MQTT-BRK-002 fails.
MQTT_PLAIN_PORT=0
